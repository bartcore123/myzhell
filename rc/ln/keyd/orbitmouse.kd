[ids]
*

[main]

f24=macro(C-tab)
f23=macro(C-S-tab)
f22=macro(M-tab)

capslock=enter
`=delete
rightalt=`

rightshift=overload(shift, end)
rightcontrol=overload(control, home)

space=overload(orbit, space)

[orbit:C]
w=up
s=down
a=left
d=right
f=home
e=end
r=delete
q=backspace
capslock=f6

[shift+orbit]
r=macro(C-backspace)
f=macro(C-delete)

[shift:S]
`=~
