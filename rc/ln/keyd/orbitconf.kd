[ids]
*

[main]

capslock=enter
`=delete
rightalt=`

rightshift=overload(shift, end)
rightcontrol=overload(control, home)

space=overload(orbit, space)

[orbit:C]
w=up
s=down
a=left
d=right
q=backspace
e=end
r=delete
f=home
capslock=f6

[shift+orbit]
r=macro(C-backspace)
f=macro(C-delete)

[shift:S]
`=~
