autoload zmv

myWordExpand () {
	zle _expand_alias
	zle _expand_word
}
zle -N myWordExpand

cmds () {
	BUFFER="\$($BUFFER)"
	CURSOR=$[CURSOR+2]
}
zle -N cmds

prms(){
	BUFFER="\${$BUFFER}"
	CURSOR=$[$#BUFFER-1]
}
zle -N prms

slap () {
	LBUFFER+=$(wl-paste) 
}
zle -N slap

insert_arith_paren () {
	LBUFFER+='$[  ]' 
	CURSOR=$[CURSOR-2] 
}
zle -N insert_arith_paren

insert_test_paren () {
	LBUFFER+='[[  ]]' 
	CURSOR=$[CURSOR-3] 
}
zle -N insert_test_paren

insert_mathy_paren () {
	LBUFFER+='((  ))' 
	CURSOR=$[ CURSOR-3 ] 
}
zle -N insert_mathy_paren

kill-region-or-rbuffer () {
	[[ $MARK == 0 ]] && zle kill-line || zle kill-region
}
zle -N kill-region-or-rbuffer

prinsert () {
	[[ $LBUFFER[1,5] == print ]] || LBUFFER="print -r -- $LBUFFER" 
}
zle -N prinsert

